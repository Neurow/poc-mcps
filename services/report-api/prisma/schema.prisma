generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Un rapport par jour. `entries` porte le détail précis "un ticket = une
// entrée" : à quelle heure la tâche a commencé (`date`, timestamp
// complet) et combien de temps elle a duré (`duration`, en minutes) —
// de quoi reconstruire entièrement ce qu'une personne a fait sur une
// journée. `content` reste un résumé libre optionnel en complément (le
// regroupement par projet, lui, reste une responsabilité du Skill, pas
// du schéma Report).
model Report {
  id        String        @id @default(cuid())
  date      DateTime      @unique @db.Date
  content   String?
  status    String        @default("draft") // draft | submitted
  entries   ReportEntry[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("reports")
}

model ReportEntry {
  id          String   @id @default(cuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  ticketId    String // référence faible vers un ticket, pas de FK inter-système — un ticket = une entrée
  date        DateTime // début précis de la tâche (timestamp complet, pas juste le jour)
  duration    Int // durée en minutes
  description String?
  createdAt   DateTime @default(now())

  @@map("report_entries")
}
