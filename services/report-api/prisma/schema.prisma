generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Un rapport par jour. `entries` porte le détail précis "de telle heure
// à telle heure, sur tel ticket" ; `content` reste un résumé libre
// optionnel en complément (le regroupement par projet, lui, reste une
// responsabilité du Skill, pas du schéma Report).
model Report {
  id        String        @id @default(cuid())
  date      DateTime      @unique @db.Date
  content   String?
  status    String        @default("draft") // draft | submitted
  entries   ReportEntry[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("reports")
}

model ReportEntry {
  id          String   @id @default(cuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  ticketId    String // référence faible vers un ticket, pas de FK inter-système
  startTime   String // "09:00"
  endTime     String // "10:30"
  description String?
  createdAt   DateTime @default(now())

  @@map("report_entries")
}
